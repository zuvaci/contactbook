@{
    ViewData["Title"] = "Home";
}
@model List<Contact>

<div class="text-center">
	<a href="@Url.Action("Add", "Home")" class="btn btn-primary mb-3">Add Contact</a>
    @foreach (var contact in Model)
    {
        <a href="ContactDetail">
        <div class="card">
                <h1>@contact.FirstName @contact.LastName</h1>
                <p>@contact.Email</p>
        </div></a>
    }
</div>
