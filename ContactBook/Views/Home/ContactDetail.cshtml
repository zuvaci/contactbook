@{
    ViewData["Title"] = "Contact Detail";
}
@model Contact

<div class="text-center">
        <div class="card">
        <a href="@Url.Action("Edit", "Home")" class="btn btn-primary mb-3">Edit Contact</a>
		<button asp-action="Delete">Delete Contact</button>
        <h1>@Model.FirstName @Model.LastName</h1>
        <p>@Model.Email</p>
        </div>
</div>